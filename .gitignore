# OS/editor noise
.DS_Store
Thumbs.db
.vscode/
*.code-workspace

# Temp artifacts
*.tmp
*.log
docs/index.html.tmp

# Python caches (if you run ots via Python locally)
__pycache__/
.venv/

# Ignore materialized OpenTimestamps proofs (decoded from base64)
#letter/*.asc.ots

# `ots upgrade` keeps the previous proof as <proof>.bak; never an artifact.
*.ots.bak
